generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  // Menor privilégio por padrão. O papel real é sempre definido pela aplicação
  // (AuthService / seed); este default é apenas defesa em profundidade.
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  cpfcnpj  String?                           // CPF/CNPJ vindo da Oficina Inteligente

  // ── Cadastro completo (tela "Adicionar Novo Cliente") ──
  whatsapp  String?
  birthDate DateTime?                         // Data de nascimento

  // Endereço estruturado
  zip          String?                        // CEP
  street       String?                        // Rua
  number       String?                        // Número
  complement   String?                        // Complemento
  neighborhood String?                        // Bairro
  city         String?
  state        String?                        // UF

  // Informações adicionais
  notes          String? @db.Text            // Observações
  preferences    String? @db.Text            // Preferências
  initialHistory String? @db.Text            // Histórico inicial
  responsible    String?                     // Responsável pelo cadastro

  // Assinaturas (dataURL PNG)
  clientSignature      String? @db.LongText
  responsibleSignature String? @db.LongText

  createdAt DateTime @default(now())

  vehicles   Vehicle[]
  checklists Checklist[]
}

model Vehicle {
  id        String   @id @default(uuid())
  plate     String
  brand     String
  model     String
  year      Int

  // ── Campos adicionais (cadastro completo) ──
  color    String?
  mileage  Int?                               // Quilometragem
  chassis  String?
  renavam  String?

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  diagnostics Diagnostic[]
  checklists  Checklist[]
}

// ── Checklist / Vistoria de veículo ──────────────────────────
// Prontuário de entrada do veículo na oficina. Guarda snapshots de cliente e
// veículo para preservar o histórico mesmo que o cadastro mude depois.
model Checklist {
  id        String   @id @default(uuid())

  // Vínculos opcionais — o fluxo da nova seção de Check-list cria registros
  // "avulsos" (só snapshot); o fluxo do ClientProfile ainda envia vehicleId.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  clientId  String?                                  // denormalizado p/ query do perfil
  client    Client?  @relation(fields: [clientId], references: [id])

  // Protocolo / Unidade de atendimento
  unit        String?                                // MECANICA | FUNILARIA | BLINDADOS
  protocol    String?                                // ex. CL-MEC-0052/26
  protocolSeq Int?                                   // sequência numérica (base p/ próximo)

  // Status do Veículo (abas do checklist)
  status       String    @default("IN_SERVICE")      // IN_SERVICE | WAITING_PARTS | READY | DELIVERED
  entryDate    DateTime?                              // Data de entrada
  expectedDate DateTime?                              // Previsão de entrega
  exitDate     DateTime?                              // Data de saída
  responsible  String?                                // Responsável

  // Snapshot — Dados do Cliente
  clientName    String
  clientPhone   String?                               // Telefone
  clientMobile  String?                               // Celular / WhatsApp
  clientPhone2  String?                               // Telefone 2
  clientEmail   String?
  clientCpfCnpj String?
  clientRg      String?                               // RG / I.E.
  clientNotes   String?  @db.Text                     // Outros / Observações (cliente)

  // Endereço estruturado
  clientAddress      String?  @db.Text                // Logradouro / endereço completo
  clientNeighborhood String?                          // Bairro
  clientCity         String?                          // Cidade
  clientState        String?                          // Estado
  clientZip          String?                          // CEP

  // Snapshot — Dados do Veículo
  vBrand   String?
  vModel   String?
  vYear    Int?
  vPlate   String?
  vColor   String?
  vChassis String?
  kmIn     Int?
  kmOut    Int?

  // Combustível
  fuelType  String?                                   // Gasolina | Diesel | Etanol | Outro
  fuelLevel Int?                                       // 0..100 (%)

  // Seções item → condição (JSON: { "Antena": "OK", "Estepe": "AUSENTE", ... })
  externalAccessories Json?
  safetyEquipment     Json?
  interiorTech        Json?

  // Mapeamento de avarias (JSON: [{ x, y, type: "RISCO"|"AMASSADO"|"QUEBRA" }])
  damageMarks Json?

  // Diagnóstico e Prazos
  diagnosis         String? @db.Text
  requestedServices String? @db.Text
  observations      String? @db.Text

  // Assinaturas (imagem opcional em base64 dataURL)
  signCompanyName  String?
  signClientName   String?
  signCompanyImage String? @db.LongText
  signClientImage  String? @db.LongText
  signedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([vehicleId])
}

model Diagnostic {
  id          String   @id @default(uuid())
  description String   @db.Text
  status      String   @default("PENDING")

  // ── Diagnóstico por IA (Gemini) ──
  complaint   String?  @db.Text   // queixa do cliente
  obdCode     String?             // código OBD informado
  system      String?             // sistema afetado (Elétrico, Mecânico…)
  confidence  String?             // Alta | Média | Baixa
  aiResult    String?  @db.Text   // JSON completo retornado pela IA
  source      String   @default("manual") // manual | ai

  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  createdAt   DateTime @default(now())

  serviceOrders ServiceOrder[]
}

model ServiceOrder {
  id           String   @id @default(uuid())
  status       String   @default("OPEN")
  notes        String?  @db.Text

  oiId         String?  @unique               // OrdemDeServicoID da Oficina Inteligente
  oiTotal      Float?                         // ValorDaOrdemDeServico

  expectedDeliveryDate DateTime?              // Previsão de saída/entrega do veículo

  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Integrações ──────────────────────────────────────────────

model ImportJob {
  id         String   @id @default(uuid())
  type       String                          // "clients" | "vehicles"
  filename   String
  total      Int      @default(0)
  imported   Int      @default(0)
  skipped    Int      @default(0)
  errors     String?  @db.Text               // JSON array de mensagens
  status     String   @default("DONE")       // DONE | FAILED
  createdAt  DateTime @default(now())
}

model OiSyncJob {
  id        String   @id @default(uuid())
  source    String   @default("api")          // "api" (webservice) | "scrape" (coletor/bookmarklet)
  date      String                            // dd/MM/yyyy sincronizada (ou label da coleta)
  kind      String   @default("orders")       // orders | clients | vehicles
  total     Int      @default(0)              // registros recebidos
  created   Int      @default(0)              // novos criados no Prost
  updated   Int      @default(0)              // atualizados
  skipped   Int      @default(0)              // ignorados ou com erro
  errors    String?  @db.Text                 // JSON array de mensagens de erro
  status    String   @default("DONE")         // DONE | FAILED
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id          String   @id @default(uuid())
  source      String                          // "oficina_inteligente"
  event       String                          // tipo do evento
  payload     String   @db.Text              // JSON bruto recebido
  status      String   @default("RECEIVED")  // RECEIVED | PROCESSED | FAILED | IGNORED
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  processedAt DateTime?
}