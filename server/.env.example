# Copie para server/.env e preencha os valores. Nenhum destes é versionado.

# Banco de dados (MySQL). Formato: mysql://user:pass@host:port/db
DATABASE_URL=

# Segredo de assinatura do JWT — OBRIGATÓRIO. O servidor não sobe sem ele.
# Gere um valor forte e aleatório, ex.: openssl rand -hex 32
JWT_SECRET=

# Oficina Inteligente — token da API usado na sincronização
OI_TOKEN=

# Segredo HMAC para validar os webhooks recebidos da Oficina Inteligente (opcional)
OI_WEBHOOK_SECRET=

# Google Gemini (Diagnóstico por IA) — chave do Google AI Studio
GEMINI_API_KEY=

# Opcional: sobrescrever o modelo (padrão: gemini-3-flash-preview)
# GEMINI_MODEL=

# Opcional: porta HTTP (padrão: 3000)
# PORT=3000
