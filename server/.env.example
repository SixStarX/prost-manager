# Copie para server/.env e preencha os valores. Nenhum destes é versionado.

# Banco de dados (MySQL). Formato: mysql://user:pass@host:port/db
DATABASE_URL=

# Segredo de assinatura do JWT — OBRIGATÓRIO. O servidor não sobe sem ele.
# Gere um valor forte e aleatório, ex.: openssl rand -hex 32
JWT_SECRET=

# ── Bootstrap do primeiro administrador (usado só pelo `npm run seed`) ──
# O registro público foi removido; o ADMIN inicial é criado por este seed.
# É idempotente: só cria se ainda não houver nenhum ADMIN. Não versione valores reais.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Opcional: nome exibido do admin (padrão: "Administrador")
# ADMIN_BOOTSTRAP_NAME=

# Oficina Inteligente — token da API usado na sincronização
OI_TOKEN=

# Segredo HMAC dos webhooks da Oficina Inteligente.
# OBRIGATÓRIO em produção: com NODE_ENV=production e sem este valor, todo
# webhook é recusado (fail-closed). Fora de produção, se vazio, aceita sem verificar.
OI_WEBHOOK_SECRET=

# Token compartilhado do coletor (bookmarklet), enviado no header X-Collector-Token.
# OBRIGATÓRIO em produção (senão POST /oi/scrape é recusado). Gere: openssl rand -hex 24
COLLECTOR_TOKEN=

# Google Gemini (Diagnóstico por IA) — chave do Google AI Studio
GEMINI_API_KEY=

# Opcional: sobrescrever o modelo (padrão: gemini-3-flash-preview)
# GEMINI_MODEL=

# Ambiente. Defina "production" no deploy — ativa o fail-closed do webhook e do coletor.
# NODE_ENV=production

# Opcional: porta HTTP (padrão: 3000)
# PORT=3000
